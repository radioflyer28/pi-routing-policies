{
  "name": "pi-routing-policies",
  "version": "0.1.0",
  "private": true,
  "description": "Declarative model-routing policies for Pi, with interchangeable LLM and decision-model selectors",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "pi-package",
    "model-routing",
    "virtual-models"
  ],
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./classifier": {
      "types": "./dist/classifier.d.ts",
      "import": "./dist/classifier.js"
    },
    "./llm": {
      "types": "./dist/llm.d.ts",
      "import": "./dist/llm.js"
    },
    "./selectors": {
      "types": "./dist/selectors.d.ts",
      "import": "./dist/selectors.js"
    }
  },
  "files": [
    "dist",
    "src",
    "examples",
    "README.md",
    "docs",
    "evaluation/corpus-v1.json",
    "evaluation/answers-fixture-v1.json",
    "scripts/evaluate.mjs",
    "skills"
  ],
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "verify": "npm run check && npm test && npm run build && node scripts/check-package.mjs",
    "evaluate": "node --experimental-strip-types scripts/evaluate.mjs",
    "test:compat": "node --experimental-strip-types --test tests/compatibility.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "@types/node": "^24.0.0",
    "typebox": "1.3.34",
    "typescript": "~5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/radioflyer28/pi-routing-policies.git"
  },
  "homepage": "https://github.com/radioflyer28/pi-routing-policies#readme",
  "bugs": {
    "url": "https://github.com/radioflyer28/pi-routing-policies/issues"
  }
}
